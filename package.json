{
  "name": "nba-stats",
  "version": "2.0.0",
  "description": "NBA statistics site - Express + MongoDB, data scraped from nba.com",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/app.js",
    "start:prod": "pm2 start ecosystem.config.js --env production",
    "start:dev": "pm2 start ecosystem.config.js",
    "scrape": "node src/db.js all",
    "scrape:teams": "node src/db.js teams",
    "scrape:games": "node src/db.js games",
    "scrape:careerstats": "node src/db.js careerstats",
    "scrape:summary": "node src/db.js summary",
    "build:css": "gulp buildStylesProd",
    "watch:css": "gulp",
    "test": "jest",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SigmaGrindset/nba-stats.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SigmaGrindset/nba-stats/issues"
  },
  "homepage": "https://github.com/SigmaGrindset/nba-stats#readme",
  "dependencies": {
    "axios": "^1.7.9",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "mongoose-autopopulate": "^1.1.0",
    "morgan": "^1.10.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/k6": "^0.54.2",
    "cypress": "^13.17.0",
    "cypress-wait-until": "^3.0.2",
    "gulp": "^5.0.0",
    "gulp-cli": "^3.0.0",
    "gulp-purgecss": "^6.0.0",
    "gulp-sass": "^6.0.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "pm2": "^5.4.3",
    "sass": "^1.83.4"
  },
  "directories": {
    "test": "test"
  }
}
